# ---------------------------------------------------------------------------
# Memory Lane configuration. Copy to `.env` and fill in what you need.
# Everything is optional: with no keys, Memory Lane runs fully offline.
# ---------------------------------------------------------------------------

# Answer model — the first one configured is used (or force one with LLM_PROVIDER).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1   # any OpenAI-compatible endpoint works
# OLLAMA_URL=http://localhost:11434           # local models via Ollama
# OLLAMA_MODEL=llama3.1
# LLM_PROVIDER=auto                           # auto | gemini | openai | ollama | offline

# Embeddings: auto tries a free local model (fastembed), then your API key, then a built-in fallback.
EMBEDDINGS=auto
# FASTEMBED_MODEL=BAAI/bge-small-en-v1.5

# Server
HOST=127.0.0.1
PORT=8000
# SEED_DEMO=1                # create the three demo archives on first start
# MAX_UPLOAD_MB=25
# CORS_ORIGINS=*             # comma-separated list in production
# MEMORY_LANE_DATA_DIR=./data
